# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/db_name

# JWT/Auth
SECRET_KEY=replace_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email credentials (SMTP login)
EMAIL_ID=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Password reset settings
RESET_TOKEN_EXPIRE_MINUTES=15
RESET_PASSWORD_BASE_URL=http://127.0.0.1:8000/reset-password
